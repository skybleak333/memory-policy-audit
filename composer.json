        "fedoseev/hindsight-php": "^0.15 || ^0.16 || ^0.17"
    },
    "autoload": {
        "psr-4": {"MemoryPolicyAudit\\": "src/"}
    },
    "config": {
        "platform": {"php": "8.2.0"},
