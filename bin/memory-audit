#!/usr/bin/env php
<?php

declare(strict_types=1);

use Fedoseev\Hindsight\Hindsight;
use MemoryPolicyAudit\Audit;
use MemoryPolicyAudit\Catalog;
use MemoryPolicyAudit\DecisionRecord;
use MemoryPolicyAudit\Relate;

require __DIR__.'/../src/Audit.php';
require __DIR__.'/../src/Catalog.php';
require __DIR__.'/../src/DecisionRecord.php';
require __DIR__.'/../src/Relate.php';

const USAGE = <<<'TEXT'
    php bin/memory-audit demo [--as-of=YYYY-MM-DD] [--known-on=YYYY-MM-DD] [--json | --record]
    php bin/memory-audit audit --catalog=FILE --recall=FILE [--as-of=YYYY-MM-DD] [--known-on=YYYY-MM-DD] [--json | --record]
    php bin/memory-audit audit --catalog=FILE --bank=BANK --query=QUESTION [--as-of=YYYY-MM-DD] [--known-on=YYYY-MM-DD] [--json | --record]
    php bin/memory-audit replay --record=FILE [--json]

    --as-of selects the effective date. --known-on limits the catalog to published revisions.
    --record writes a replayable decision record to stdout in audit and demo mode.
    --relate=PATH selects the Relate CLI (defaults to relate on PATH).
    Live recall uses HINDSIGHT_URL and optional HINDSIGHT_API_KEY.
    TEXT;

function readJson(string $path): array
{
    if (!is_file($path) || false === ($contents = file_get_contents($path))) {
        throw new InvalidArgumentException("Could not read {$path}.");
    }

    $data = json_decode($contents, true, flags: JSON_THROW_ON_ERROR);
    if (!is_array($data)) {
        throw new InvalidArgumentException("Expected a JSON object in {$path}.");
    }

    return $data;
}

/** @return array<string, string|true> */
function parseOptions(array $arguments, array $allowed, array $flags): array
{
    $options = [];
    foreach ($arguments as $argument) {
        if (in_array($argument, $flags, true)) {
            $options[substr($argument, 2)] = true;
            continue;
        }

        if (!preg_match('/\A--([a-z-]+)=(.+)\z/s', $argument, $parts) || !in_array($parts[1], $allowed, true)) {
            throw new InvalidArgumentException("Unknown or empty option: {$argument}");
        }

        if (isset($options[$parts[1]])) {
            throw new InvalidArgumentException("Option --{$parts[1]} was given twice.");
        }

        $options[$parts[1]] = $parts[2];
    }

    return $options;
}

function liveRecall(string $bank, string $question, string $asOf): array
{
    $autoload = __DIR__.'/../vendor/autoload.php';
    if (!is_file($autoload)) {
        throw new RuntimeException('Run composer install before using live Hindsight recall.');
    }
    require $autoload;

    $url = getenv('HINDSIGHT_URL');
    if ($url === false || $url === '') {
        throw new InvalidArgumentException('Set HINDSIGHT_URL for live recall.');
    }

    $client = new Hindsight($url, apiKey: getenv('HINDSIGHT_API_KEY') ?: null);

    return $client->recall($bank, $question, queryTimestamp: $asOf.'T23:59:59Z')->raw;
}

/** @return array{Catalog, array} */
function auditInputs(string $mode, array $options, string $asOf): array
{
    if ($mode === 'demo') {
        return [new Catalog(readJson(__DIR__.'/../examples/policies.json')), readJson(__DIR__.'/../examples/recall.json')];
    }

    if (!isset($options['catalog'])) {
        throw new InvalidArgumentException('Provide a revision catalog with --catalog=FILE.');
    }
    $catalog = new Catalog(readJson($options['catalog']));

    if (isset($options['recall']) && !isset($options['bank']) && !isset($options['query'])) {
        return [$catalog, readJson($options['recall'])];
    }
    if (!isset($options['recall']) && isset($options['bank'], $options['query'])) {
        return [$catalog, liveRecall($options['bank'], $options['query'], $asOf)];
    }

    throw new InvalidArgumentException('Use --recall=FILE for a saved response or --bank=BANK and --query=QUESTION for live recall.');
}

function printable(string $text): string
{
    return preg_replace('/[\x00-\x1F\x7F]/u', ' ', $text) ?? $text;
}

function printReport(array $report): void
{
    printf("As of %s\n", $report['as_of']);
    if (isset($report['known_on'])) {
        printf("Published by %s\n", $report['known_on']);
    }
    echo PHP_EOL;
    foreach ($report['decisions'] as $decision) {
        printf("  %-19s %s", $decision['status'], printable($decision['document_id'] ?? $decision['memory_id']));
        $otherRevisions = $decision['superseded_by'] ?? $decision['current_revisions'] ?? [];
        if ($otherRevisions !== []) {
            printf(' (%s)', printable(implode(', ', $otherRevisions)));
        }
        if (isset($decision['published_on'])) {
            printf(' (published %s)', $decision['published_on']);
        }
        echo PHP_EOL;
    }

    echo "\nAgent context\n";
    if ($report['context'] === []) {
        echo "  No current sources.\n";
    }
    foreach ($report['context'] as $entry) {
        printf("  %s\n  %s\n", printable($entry['text']), printable($entry['citation']));
        if (isset($entry['recovered_from'])) {
            printf("  Recovered from %s\n", printable($entry['recovered_from']));
        }
    }
}

try {
    $mode = $argv[1] ?? '--help';
    if ($mode === '--help' || in_array('--help', array_slice($argv, 2), true)) {
        echo USAGE, PHP_EOL;
        exit(0);
    }

    $allowed = match ($mode) {
        'demo' => ['as-of', 'known-on'],
        'audit' => ['as-of', 'known-on', 'catalog', 'recall', 'bank', 'query'],
        'replay' => ['record'],
        default => throw new InvalidArgumentException("Unknown command: {$mode}"),
    };
    $flags = $mode === 'replay' ? ['--json'] : ['--json', '--record'];
    $options = parseOptions(array_slice($argv, 2), ['relate', ...$allowed], $flags);
    $audit = new Audit(new Relate($options['relate'] ?? 'relate'));

    if ($mode === 'replay') {
        if (!isset($options['record'])) {
            throw new InvalidArgumentException('Provide a decision record with --record=FILE.');
        }
        $report = DecisionRecord::replay(readJson($options['record']), $audit);
    } else {
        if (isset($options['record'], $options['json'])) {
            throw new InvalidArgumentException('Choose either --record or --json.');
        }
        $asOf = Catalog::date($options['as-of'] ?? ($mode === 'demo' ? '2026-11-23' : gmdate('Y-m-d')));
        $knownOn = isset($options['known-on']) ? Catalog::date($options['known-on']) : null;
        [$catalog, $recall] = auditInputs($mode, $options, $asOf);
        $report = $audit->run($catalog, $recall, $asOf, $knownOn);
    }

    $capture = $mode !== 'replay' && isset($options['record']);
    if ($capture || isset($options['json'])) {
        $output = $capture ? DecisionRecord::capture($catalog, $recall, $report) : $report;
        echo json_encode($output, JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), PHP_EOL;
    } else {
        printReport($report);
    }
} catch (Throwable $error) {
    fwrite(STDERR, printable($error->getMessage()).PHP_EOL);
    exit(1);
}
