#!/usr/bin/env php
<?php

declare(strict_types=1);

use Fedoseev\Hindsight\Hindsight;
use MemoryPolicyAudit\Audit;
use MemoryPolicyAudit\Catalog;
use MemoryPolicyAudit\DecisionComparison;
use MemoryPolicyAudit\DecisionRecord;
use MemoryPolicyAudit\Relate;

require __DIR__.'/../src/Audit.php';
require __DIR__.'/../src/Catalog.php';
require __DIR__.'/../src/DecisionComparison.php';
require __DIR__.'/../src/DecisionRecord.php';
require __DIR__.'/../src/Relate.php';

const USAGE = <<<'TEXT'
    php bin/memory-audit demo [--as-of=YYYY-MM-DD] [--known-on=YYYY-MM-DD] [--json | --record]
    php bin/memory-audit audit --catalog=FILE --recall=FILE [--as-of=YYYY-MM-DD] [--known-on=YYYY-MM-DD] [--json | --record]
    php bin/memory-audit audit --catalog=FILE --bank=BANK --query=QUESTION [--as-of=YYYY-MM-DD] [--known-on=YYYY-MM-DD] [--json | --record]
    php bin/memory-audit replay --record=FILE [--json]
    php bin/memory-audit compare --before=FILE --after=FILE [--json]
    php bin/memory-audit eval --dataset=FILE [--json]

    --as-of selects the effective date. --known-on limits the catalog to published revisions.
    --record writes a replayable decision record to stdout in audit and demo mode.
    --relate=PATH selects the Relate CLI (defaults to relate on PATH).
    Live recall uses HINDSIGHT_URL and optional HINDSIGHT_API_KEY.
    TEXT;

function readJson(string $path): array
{
    if (!is_file($path) || false === ($contents = file_get_contents($path))) {
        throw new InvalidArgumentException("Could not read {$path}.");
    }

    $data = json_decode($contents, true, flags: JSON_THROW_ON_ERROR);
    if (!is_array($data)) {
        throw new InvalidArgumentException("Expected a JSON object in {$path}.");
    }

    return $data;
}

/** @return array<string, string|true> */
function parseOptions(array $arguments, array $allowed, array $flags): array
{
    $options = [];
    foreach ($arguments as $argument) {
        if (in_array($argument, $flags, true)) {
            $options[substr($argument, 2)] = true;
            continue;
        }

        if (!preg_match('/\A--([a-z-]+)=(.+)\z/s', $argument, $parts) || !in_array($parts[1], $allowed, true)) {
            throw new InvalidArgumentException("Unknown or empty option: {$argument}");
        }

        if (isset($options[$parts[1]])) {
            throw new InvalidArgumentException("Option --{$parts[1]} was given twice.");
        }

        $options[$parts[1]] = $parts[2];
    }

    return $options;
}

function liveRecall(string $bank, string $question, string $asOf): array
{
    $autoload = __DIR__.'/../vendor/autoload.php';
    if (!is_file($autoload)) {
        throw new RuntimeException('Run composer install before using live Hindsight recall.');
    }
    require $autoload;

    $url = getenv('HINDSIGHT_URL');
    if ($url === false || $url === '') {
        throw new InvalidArgumentException('Set HINDSIGHT_URL for live recall.');
    }

    $client = new Hindsight($url, apiKey: getenv('HINDSIGHT_API_KEY') ?: null);

    return $client->recall($bank, $question, queryTimestamp: $asOf.'T23:59:59Z')->raw;
}

/** @return array{Catalog, array} */
function auditInputs(string $mode, array $options, string $asOf): array
{
    if ($mode === 'demo') {
        return [new Catalog(readJson(__DIR__.'/../examples/policies.json')), readJson(__DIR__.'/../examples/recall.json')];
    }

    if (!isset($options['catalog'])) {
        throw new InvalidArgumentException('Provide a revision catalog with --catalog=FILE.');
    }
    $catalog = new Catalog(readJson($options['catalog']));

    if (isset($options['recall']) && !isset($options['bank']) && !isset($options['query'])) {
        return [$catalog, readJson($options['recall'])];
    }
    if (!isset($options['recall']) && isset($options['bank'], $options['query'])) {
        return [$catalog, liveRecall($options['bank'], $options['query'], $asOf)];
    }

    throw new InvalidArgumentException('Use --recall=FILE for a saved response or --bank=BANK and --query=QUESTION for live recall.');
}

function printable(string $text): string
{
    return preg_replace('/[\x00-\x1F\x7F]/u', ' ', $text) ?? $text;
}

function printReport(array $report): void
{
    printf("As of %s\n", $report['as_of']);
    if (isset($report['known_on'])) {
        printf("Published by %s\n", $report['known_on']);
    }
    echo PHP_EOL;
    foreach ($report['decisions'] as $decision) {
        printf("  %-19s %s", $decision['status'], printable($decision['document_id'] ?? $decision['memory_id']));
        $otherRevisions = $decision['superseded_by'] ?? $decision['current_revisions'] ?? [];
        if ($otherRevisions !== []) {
            printf(' (%s)', printable(implode(', ', $otherRevisions)));
        }
        if (isset($decision['published_on'])) {
            printf(' (published %s)', $decision['published_on']);
        }
        echo PHP_EOL;
    }

    echo "\nAgent context\n";
    if ($report['context'] === []) {
        echo "  No current sources.\n";
    }
    foreach ($report['context'] as $entry) {
        printf("  %s\n  %s\n", printable($entry['text']), printable($entry['citation']));
        if (isset($entry['recovered_from'])) {
            printf("  Recovered from %s\n", printable($entry['recovered_from']));
        }
    }
}

function printComparison(array $comparison): void
{
    foreach (['before' => 'Before', 'after' => 'After'] as $side => $label) {
        $dates = $comparison[$side];
        printf("%s: effective %s, %s\n", $label, $dates['as_of'], $dates['known_on'] === null ? 'all publications' : 'published by '.$dates['known_on']);
    }
    if ($comparison['catalog_changed'] || $comparison['recall_sources_changed']) {
        $changed = array_filter([
            $comparison['catalog_changed'] ? 'policy catalog' : null,
            $comparison['recall_sources_changed'] ? 'recalled source IDs or order' : null,
        ]);
        printf("Other inputs changed: %s\n", implode(', ', $changed));
    }

    foreach (['newly_visible' => 'Newly visible publications', 'no_longer_visible' => 'No longer visible'] as $key => $label) {
        if ($comparison[$key] === []) {
            continue;
        }
        printf("\n%s\n", $label);
        foreach ($comparison[$key] as $revision) {
            printf("  %s, published %s, effective %s\n", printable($revision['id']), $revision['published_on'], $revision['effective_on']);
        }
    }

    if ($comparison['context_changes'] === []) {
        echo "\nNo policy context changed.\n";
    }
    foreach ($comparison['context_changes'] as $change) {
        printf("\n%s\n", printable($change['policy']));
        foreach (['before' => 'Before', 'after' => 'After'] as $side => $label) {
            printf("  %s\n", $label);
            if ($change[$side] === []) {
                echo "    No current source.\n";
            }
            foreach ($change[$side] as $entry) {
                printf("    %s\n    %s\n", printable($entry['text']), printable($entry['citation']));
            }
        }
    }
}

/** Sort object keys without changing the order of sources supplied to the agent. */
function evaluationContext(array $entries): array
{
    foreach ($entries as &$entry) {
        if (!is_array($entry) || array_is_list($entry)) {
            throw new InvalidArgumentException('Each expected context entry must be an object.');
        }
        ksort($entry, SORT_STRING);
    }
    unset($entry);

    return $entries;
}

function evaluateDataset(Audit $audit, string $file): array
{
    $dataset = readJson($file);
    $directory = dirname($file);
    $defaultCatalog = Catalog::requiredString($dataset, 'catalog');
    $cases = $dataset['cases'] ?? null;
    if (!is_array($cases) || !array_is_list($cases) || $cases === []) {
        throw new InvalidArgumentException('The dataset needs a non-empty cases list.');
    }

    $results = [];
    $catalogs = [];
    $failed = 0;
    foreach ($cases as $case) {
        if (!is_array($case)) {
            throw new InvalidArgumentException('Each evaluation case must be an object.');
        }
        $id = Catalog::requiredString($case, 'id');
        if (isset($results[$id])) {
            throw new InvalidArgumentException("Duplicate evaluation case ID: {$id}.");
        }

        try {
            $catalogFile = array_key_exists('catalog', $case) ? Catalog::requiredString($case, 'catalog') : $defaultCatalog;
            $catalog = $catalogs[$catalogFile] ??= new Catalog(readJson($directory.'/'.$catalogFile));
            $recall = readJson($directory.'/'.Catalog::requiredString($case, 'recall'));
            $asOf = Catalog::requiredString($case, 'as_of');
            $knownOn = array_key_exists('known_on', $case) ? Catalog::requiredString($case, 'known_on') : null;
            $expected = $case['expect'] ?? null;
            foreach (['statuses', 'context'] as $key) {
                if (!is_array($expected[$key] ?? null) || !array_is_list($expected[$key])) {
                    throw new InvalidArgumentException("Expected {$key} must be a list.");
                }
            }
            $expected['context'] = evaluationContext($expected['context']);

            $report = $audit->run($catalog, $recall, $asOf, $knownOn);
            $actual = [
                'statuses' => array_column($report['decisions'], 'status'),
                'context' => evaluationContext($report['context']),
            ];
            $differences = [];
            foreach ($actual as $key => $value) {
                if ($expected[$key] !== $value) {
                    $differences[] = ['field' => $key, 'expected' => $expected[$key], 'actual' => $value];
                }
            }
        } catch (InvalidArgumentException|RuntimeException|JsonException $error) {
            throw new RuntimeException("Case {$id}: ".$error->getMessage(), previous: $error);
        }

        $passed = $differences === [];
        if (!$passed) {
            $failed++;
        }
        $results[$id] = ['id' => $id, 'passed' => $passed, 'differences' => $differences];
    }

    return [
        'passed' => count($results) - $failed,
        'failed' => $failed,
        'cases' => array_values($results),
    ];
}

function printEvaluation(array $evaluation): void
{
    foreach ($evaluation['cases'] as $case) {
        printf("%s %s\n", $case['passed'] ? 'PASS' : 'FAIL', printable($case['id']));
        foreach ($case['differences'] as $difference) {
            printf("  %s\n", $difference['field']);
            foreach (['expected', 'actual'] as $label) {
                printf("    %s %s\n", $label, json_encode($difference[$label], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES));
            }
        }
    }
    printf("\n%d passed, %d failed\n", $evaluation['passed'], $evaluation['failed']);
}

try {
    $mode = $argv[1] ?? '--help';
    if ($mode === '--help' || in_array('--help', array_slice($argv, 2), true)) {
        echo USAGE, PHP_EOL;
        exit(0);
    }

    $allowed = match ($mode) {
        'demo' => ['as-of', 'known-on'],
        'audit' => ['as-of', 'known-on', 'catalog', 'recall', 'bank', 'query'],
        'replay' => ['record'],
        'compare' => ['before', 'after'],
        'eval' => ['dataset'],
        default => throw new InvalidArgumentException("Unknown command: {$mode}"),
    };
    $flags = in_array($mode, ['demo', 'audit'], true) ? ['--json', '--record'] : ['--json'];
    $options = parseOptions(array_slice($argv, 2), ['relate', ...$allowed], $flags);
    $audit = new Audit(new Relate($options['relate'] ?? 'relate'));

    if ($mode === 'eval') {
        if (!isset($options['dataset'])) {
            throw new InvalidArgumentException('Provide an evaluation dataset with --dataset=FILE.');
        }
        $evaluation = evaluateDataset($audit, $options['dataset']);
        if (isset($options['json'])) {
            echo json_encode($evaluation, JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), PHP_EOL;
        } else {
            printEvaluation($evaluation);
        }
        exit($evaluation['failed'] === 0 ? 0 : 2);
    }

    if ($mode === 'compare') {
        if (!isset($options['before'], $options['after'])) {
            throw new InvalidArgumentException('Provide both decision records with --before=FILE and --after=FILE.');
        }
        $report = (new DecisionComparison($audit))->compare(readJson($options['before']), readJson($options['after']));
    } elseif ($mode === 'replay') {
        if (!isset($options['record'])) {
            throw new InvalidArgumentException('Provide a decision record with --record=FILE.');
        }
        $report = DecisionRecord::replay(readJson($options['record']), $audit);
    } else {
        if (isset($options['record'], $options['json'])) {
            throw new InvalidArgumentException('Choose either --record or --json.');
        }
        $asOf = Catalog::date($options['as-of'] ?? ($mode === 'demo' ? '2026-11-23' : gmdate('Y-m-d')));
        $knownOn = isset($options['known-on']) ? Catalog::date($options['known-on']) : null;
        [$catalog, $recall] = auditInputs($mode, $options, $asOf);
        $report = $audit->run($catalog, $recall, $asOf, $knownOn);
    }

    $capture = in_array($mode, ['demo', 'audit'], true) && isset($options['record']);
    if ($capture || isset($options['json'])) {
        $output = $capture ? DecisionRecord::capture($catalog, $recall, $report) : $report;
        echo json_encode($output, JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), PHP_EOL;
    } elseif ($mode === 'compare') {
        printComparison($report);
    } else {
        printReport($report);
    }
} catch (Throwable $error) {
    fwrite(STDERR, printable($error->getMessage()).PHP_EOL);
    exit(1);
}
